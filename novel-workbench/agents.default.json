{
  "schema_version": 1,
  "providers": {
    "mock": {
      "type": "mock"
    },
    "deepseek": {
      "type": "openai",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "ollama": {
      "type": "openai",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": "OLLAMA_API_KEY",
      "api_key_optional": true
    }
  },
  "roles": {
    "writer": {
      "provider": "mock",
      "model": "mock-writer",
      "temperature": 0.8,
      "timeout_s": 300,
      "max_attempts": 2,
      "max_tokens": 4096
    },
    "judge": {
      "provider": "mock",
      "model": "mock-judge",
      "temperature": 0.2,
      "timeout_s": 600,
      "max_attempts": 2,
      "max_tokens": 2048
    },
    "scout": {
      "provider": "mock",
      "model": "mock-scout",
      "temperature": 0.4,
      "timeout_s": 180,
      "max_attempts": 2,
      "max_tokens": 2048
    }
  },
  "budgets": {
    "llm_rounds": 400,
    "fix_rounds": 2,
    "n20_rounds": 2,
    "node_timeout_s": 900,
    "max_completion_tokens": 200000,
    "max_tool_steps": 48,
    "_note": "llm_rounds 按 chat 轮计（runtime.mjs:295），不是按节点数。130 章约需 300+ llm 节点 × 3–6 轮 → 400 只够 25–40 章/run，130 章要 3–4 个 run。单次 run 的预算是 400，不是全书写完的预算。（2026-10-25 从 60 调）"
  }
}
